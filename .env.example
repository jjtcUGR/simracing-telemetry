# Copia este fichero a .env y cambia los valores: cp .env.example .env
# .env está en .gitignore: NUNCA subas credenciales reales al repositorio.
# Usa solo letras, números, guiones y guiones bajos en las contraseñas (van dentro de URLs).

# MongoDB
MONGO_USUARIO=simracing
MONGO_PASSWORD=cambia-esta-password
MONGO_DB=simracing

# Redis
REDIS_PASSWORD=cambia-esta-password

# Tokens de API admitidos, separados por comas (cada piloto o plugin usa el suyo)
API_TOKENS=token-dev-piloto-1,token-dev-piloto-2

# Sal para seudonimizar el identificador del piloto (RGPD)
SALT_SEUDONIMO=cambia-esta-sal

# Puertos publicados en tu máquina
PUERTO_INGESTA=8001
PUERTO_BUSQUEDA=8002

LOG_LEVEL=INFO
